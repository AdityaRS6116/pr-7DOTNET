@model Practical_7.Models.Feedback

@using (Html.BeginForm("GiveFeedback", "Feedback", FormMethod.Post))
{
    <div class="form-group">

        @Html.LabelFor(model => model.StudentName)

        @Html.TextBoxFor(
            model => model.StudentName,
            new
            {
                @class = "form-control",
                placeholder = "Enter student name"
            }
        )

        @Html.ValidationMessageFor(
            model => model.StudentName,
            "",
            new { @class = "text-danger" }
        )

    </div>

    <div class="form-group">

        @Html.LabelFor(model => model.EnrollmentNumber)

        @Html.TextBoxFor(
            model => model.EnrollmentNumber,
            new
            {
                @class = "form-control",
                placeholder = "Enter enrollment number"
            }
        )

        @Html.ValidationMessageFor(
            model => model.EnrollmentNumber,
            "",
            new { @class = "text-danger" }
        )

    </div>

    <div class="form-group">

        @Html.LabelFor(model => model.Subject)

        @Html.TextBoxFor(
            model => model.Subject,
            new
            {
                @class = "form-control",
                placeholder = "Enter subject"
            }
        )

        @Html.ValidationMessageFor(
            model => model.Subject,
            "",
            new { @class = "text-danger" }
        )

    </div>

    <div class="form-group">

        @Html.LabelFor(model => model.Rating)

        @Html.DropDownListFor(
            model => model.Rating,
            new SelectList(new[]
            {
                "1 - Very Poor",
                "2 - Poor",
                "3 - Average",
                "4 - Good",
                "5 - Excellent"
            }),
            "Select Rating",
            new { @class = "form-control" }
        )

        @Html.ValidationMessageFor(
            model => model.Rating,
            "",
            new { @class = "text-danger" }
        )

    </div>

    <div class="form-group">

        @Html.LabelFor(model => model.Comment)

        @Html.TextAreaFor(
            model => model.Comment,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Enter your comment"
            }
        )

        @Html.ValidationMessageFor(
            model => model.Comment,
            "",
            new { @class = "text-danger" }
        )

    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Submit Feedback
    </button>
}